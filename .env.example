# Токен бота от @BotFather
BOT_TOKEN=

# Telegram user_id администраторов через запятую
ADMIN_IDS=123456,789012

# Канал для публикаций. Можно @username или числовой id (-100...)
CHANNEL_ID=@mychannel

# Адрес SQLite (по умолчанию рядом с проектом)
DATABASE_URL=sqlite+aiosqlite:///submissions.db

# Redis (локальная разработка)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your_password  # опционально
FSM_TTL=86400  # 24 часа, время жизни состояния в Redis